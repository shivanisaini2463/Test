# Copy to .env and fill in. NEVER commit the real .env.

# NVIDIA build.nvidia.com key (starts with nvapi-). Powers Kimi K2.5 + embeddings.
NVIDIA_API_KEY=

# Password for the /admin.html knowledge panel (choose anything).
ADMIN_PASSWORD=

# Vercel Blob token — REQUIRED in production for live memory updates.
# Leave blank locally to use the data/knowledge.json file instead.
BLOB_READ_WRITE_TOKEN=

# Contact details the bot shares when it can't answer from your data.
# Email + LinkedIn have public defaults in code; set the phone here so it
# stays out of the public repo.
CONTACT_EMAIL=shivanisaini2463@gmail.com
CONTACT_PHONE=
CONTACT_LINKEDIN=https://www.linkedin.com/in/shivanisainidesigner/

# Optional model overrides (defaults shown).
# CHAT_MODEL=moonshotai/kimi-k2.5
# EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Set to 1 to run the pipeline with fake vectors (no key needed) for testing.
# MOCK_EMBED=1
